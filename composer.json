{
    "name": "metaseller/tinkoff-robot-buyer",
    "description": "Консольное приложение на Yii2, реализующее автоматизированную стратегию покупки ETF и автоматизированное управление портфелем через API Т-Инвестиций",
    "type": "project",
    "license": "Apache-2.0",
    "keywords": [
        "php",
        "Т-Инвестиции",
        "T-Invest API",
        "Tinkoff",
        "Tinkoff Invest Api",
        "Yii2",
        "T-Invest Robot Buyer"
    ],
    "homepage": "https://github.com/metaseller/tinkoff-robot-buyer",
    "authors": [
        {
            "name": "Igor Frolenkov",
            "email": "igor@frolenkov.ru"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "~8.5.12",
        "yiisoft/yii2": "^2.0.55",
        "yiisoft/yii2-bootstrap5": "^2.0.51",
        "yiisoft/yii2-redis": "^2.1.2",
        "ext-bcmath": "*",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-grpc": "^1.83.1",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "omnilight/yii2-scheduling": "^1.2",
        "metaseller/tinkoff-invest-api-v2-php": "^0.6.0",
        "telegram-bot/api": "^2.5",
        "sonko-dmitry/yii2-telegram-bot-api": "^1.0"
    },
    "require-dev": {
        "yiisoft/yii2-debug": "^2.1.28",
        "yiisoft/yii2-gii": "^2.2.7",
        "yiisoft/yii2-faker": "^2.0.5",
        "codeception/codeception": "^5.3.7",
        "symfony/browser-kit": "^8.1",
        "codeception/module-filesystem": "^3.0",
        "codeception/module-yii2": "^2.0",
        "codeception/module-asserts": "^3.3",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.0"
    },
    "config": {
        "process-timeout": 1800,
        "fxp-asset": {
            "enabled": false
        },
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        },
        "platform": {
            "php": "8.5.12"
        },
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": [
            "yii\\composer\\Installer::postInstall"
        ],
        "post-create-project-cmd": [
            "yii\\composer\\Installer::postCreateProject",
            "yii\\composer\\Installer::postInstall"
        ],
        "test": "phpunit -c phpunit.xml.dist",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "extra": {
        "yii\\composer\\Installer::postCreateProject": {
            "setPermission": [
                {
                    "runtime": "0775",
                    "web/assets": "0775",
                    "yii": "0755",
                    "init": "0755"
                }
            ]
        },
        "yii\\composer\\Installer::postInstall": {
            "generateCookieValidationKey": [
                "config/web-params-local.php"
            ]
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "app\\": "./"
        },
        "exclude-from-classmap": [
            "/components/application/",
            "/tests/"
        ]
    }
}
